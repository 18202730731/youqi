{
  "compilerOptions": {
    "target": "ES2020", "module": "ESNext", "moduleResolution": "Node",
    "jsx": "react-jsx", "strict": true, "esModuleInterop": true,
    "allowSyntheticDefaultImports": true, "resolveJsonModule": true, "skipLibCheck": true,
    "types": ["@tarojs/taro", "node"], "lib": ["DOM", "ES2020"], "noEmit": true
  },
  "include": ["src", "config", "tests"]
}
